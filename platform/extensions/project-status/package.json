{
  "name": "project-status",
  "displayName": "Project Status",
  "description": "Shows the active project template type in the status bar",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Project Status",
      "properties": {
        "projectStatus.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show template type in the status bar"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch":   "tsc -watch -p .",
    "package": "vsce package --no-yarn"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node":   "^20.0.0",
    "@vscode/vsce":  "^2.x",
    "typescript":    "^5.x"
  }
}
